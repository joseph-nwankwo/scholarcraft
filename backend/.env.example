# ── Core ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4001

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/craftsuite

# ── JWT ─────────────────────────────────────────────────────────────────────────
# JWT_ACCESS_SECRET is ScholarSuite-only. It does NOT need to match the portal or LectureSuite.
JWT_ACCESS_SECRET=<min-32-char-random-string>
JWT_REFRESH_SECRET=<min-32-char-random-string-different-from-access>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── SSO Launch Secret ────────────────────────────────────────────────────────────
# CRAFT_LAUNCH_SECRET must be identical across uamsatech.com portal, LectureSuite, and
# ScholarSuite. It MUST NOT equal JWT_ACCESS_SECRET (different purpose, different secret).
CRAFT_LAUNCH_SECRET=<min-32-char-random-string-shared-across-craft-suite>

# ── Cookies ─────────────────────────────────────────────────────────────────────
COOKIE_SECRET=<min-32-char-random-string>
COOKIE_DOMAIN=.uamsatech.com

# ── App URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://scholarcraft.uamsatech.com
APP_URL=https://api.scholarcraft.uamsatech.com

# ── SSO ─────────────────────────────────────────────────────────────────────────
# Direct /register and /register-institution. Secure by default (AS-P0-SECURITY-006A):
# unset = disabled. Only the exact values "true" or "false" are accepted. Even when
# "false", registration issues no session without central entitlement.
DISABLE_DIRECT_SIGNUP=true

# ── Central entitlement (AS-P0-SECURITY-006A) ────────────────────────────────
# REQUIRED. Login, registration and every refresh ask the UAMSA Tech portal whether
# the user is entitled to THIS product; any failure denies (fail closed).
# URL: the portal endpoint (https required in production).
CENTRAL_ENTITLEMENT_URL=https://uamsatech.com/api/internal/entitlements/verify
# This product's own service credential. Must equal the portal's <PRODUCT>_ENTITLEMENT_SERVICE_SECRET
# for this product, be >= 32 random chars, and differ from CRAFT_LAUNCH_SECRET, the JWT
# secrets and COOKIE_SECRET. Placeholder is deliberately too short to pass validation.
CENTRAL_ENTITLEMENT_SERVICE_SECRET=<generate-a-new-secret>
# Optional: request timeout in ms (500-15000, default 5000).
CENTRAL_ENTITLEMENT_TIMEOUT_MS=5000

# ── Redis ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── AWS S3 ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=scholarcraft-prod

# ── AI Providers ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# ── SMTP (Resend) ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=ScholarCraft <noreply@uamsatech.com>

# ── Billing ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=
BILLING_DEFAULT_PROVIDER=paystack
TRIAL_DAYS=14

# ── Sentry ──────────────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
