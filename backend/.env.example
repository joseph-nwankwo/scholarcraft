# ── Core ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4001

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/craftsuite

# ── JWT (must match LectureCraft and uamsatech.com exactly) ─────────────────────
JWT_ACCESS_SECRET=<min-64-char-random-string>
JWT_REFRESH_SECRET=<min-64-char-random-string>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookies ─────────────────────────────────────────────────────────────────────
COOKIE_SECRET=<min-32-char-random-string>
COOKIE_DOMAIN=.uamsatech.com

# ── App URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://scholarcraft.uamsatech.com
APP_URL=https://api.scholarcraft.uamsatech.com

# ── SSO ─────────────────────────────────────────────────────────────────────────
DISABLE_DIRECT_SIGNUP=true

# ── Redis ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── AWS S3 ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=scholarcraft-prod

# ── AI Providers ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# ── SMTP (Resend) ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=ScholarCraft <noreply@uamsatech.com>

# ── Billing ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=
BILLING_DEFAULT_PROVIDER=paystack
TRIAL_DAYS=14

# ── Sentry ──────────────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
