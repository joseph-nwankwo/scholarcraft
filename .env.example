# ══════════════════════════════════════════════════════════════════════════════
# LectureCraft — Environment Variables Reference
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env files with real secrets to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development           # development | test | production
PORT=4000

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
APP_URL=http://localhost:4000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://lecturercraft:lecturercraft_dev@localhost:5432/lecturercraft
POSTGRES_USER=lecturercraft
POSTGRES_PASSWORD=lecturercraft_dev
POSTGRES_DB=lecturercraft

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-char-random-string
JWT_REFRESH_SECRET=replace-with-different-at-least-32-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-at-least-32-char-random-cookie-secret

# ── AWS S3 (file uploads) ─────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=lecturercraft-dev-uploads
AWS_S3_BACKUP_BUCKET=lecturercraft-backups

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIza...
DEEPSEEK_API_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your-sendgrid-api-key
SMTP_FROM=LectureCraft <noreply@lecturecraft.app>
SMTP_SECURE=false

# ── Billing / Payments ────────────────────────────────────────────────────────
BILLING_DEFAULT_PROVIDER=stripe
TRIAL_DAYS=14
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYSTACK_SECRET_KEY=sk_test_...
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...

# ── Error Tracking (Sentry) ───────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_DSN_FRONTEND=

# ── Monitoring ────────────────────────────────────────────────────────────────
METRICS_SECRET=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-in-production
GRAFANA_URL=https://metrics.lecturecraft.app

# ── Frontend (Vite — prefix with VITE_) ──────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
VITE_APP_NAME=LectureCraft
VITE_SENTRY_DSN=
